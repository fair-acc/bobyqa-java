license: GPL-3.0-or-later
repository-code: "https://github.com/fair-acc/bobyqa-java"
url: "https://github.com/fair-acc/bobyqa-java"
keywords:
  - optimization
  - derivative-free
  - bounds-constrained
  - bobyqa
  - quadratic-approximation
  - trust-region
  - noise-handling
  - warm-start
  - java
  - particle-accelerator
references:
